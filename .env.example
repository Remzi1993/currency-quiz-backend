# Copy this file to .env in the project root and fill in the values.
# The application automatically loads .env from its working directory on startup.
# Existing OS environment variables and JVM system properties take precedence.
# Do not commit your .env file. Comments and quoted values are supported.

# Backend app settings.
QUESTIONS_FILE=data/questions.json
PORT=8080

# Backend admin settings.
ADMIN_USERNAME=
# Required: a salted bcrypt hash (cost 10..16), never a plaintext password.
# Generate with the hashAdminPassword task; see README for masked-input commands.
# Paste the generated hash inside single quotes, preserving its literal $ separators:
# ADMIN_PASSWORD_HASH='$2a$12$...'
ADMIN_PASSWORD_HASH=

# Required: a random signing secret of at least 32 UTF-8 bytes.
# Generate once, example to generate in PowerShell 7+ with:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=

# Optional JWT settings.
JWT_ISSUER=currency-quiz-api
JWT_AUDIENCE=currency-quiz-admin
JWT_TOKEN_TTL_SECONDS=300
# Hard login deadline. Refresh renews access without extending this JWT's expiry.
# Seconds: 600 = 10 minutes; 3600 = 1 hour; 86400 = 24 hours.
JWT_REFRESH_TOKEN_TTL_SECONDS=600

# Public browser access: * allows any origin without cookie-based credentials.
# To restrict browser access, use comma-separated origins instead, e.g. http://localhost:5173.
CORS_ALLOWED_ORIGINS=*

# Browser admin JWT cookies require an explicit, comma-separated frontend origin allowlist.
# This is separate from public CORS; '*' is never accepted here. The default is empty.
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:5173

# false is for local HTTP development only. Keep true for production HTTPS.
AUTH_COOKIE_SECURE=true

# Strict works through a same-origin /api proxy. None requires Secure=true and may be
# blocked by browser third-party cookie policies when frontend and API are different sites.
AUTH_COOKIE_SAME_SITE=Strict
